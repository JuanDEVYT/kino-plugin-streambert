{
  "id": "streambert",
  "name": "StreamBert",
  "version": "1.0.3",
  "apiVersion": 20,
  "entry": "plugin.js",
  "description": "Películas, series y anime sin anuncios con resolución multi-fuente estilo Streambert",
  "author": "JuanDEVYT",
  "homepage": "https://github.com/JuanDEVYT/kino-plugin-streambert",
  "icon": "icon.png",
  "color": "#E50914",
  "categories": ["movies", "series", "anime"],
  "capabilities": ["home", "search", "browse", "episodes", "resolve", "screen"],
  "browser": "pages",
  "hosts": [
    "vsembed.su",
    "vidfast.vc",
    "player.vidlove.cc",
    "vidlove.cc",
    "aether.ist",
    "embed.vidrift.net",
    "vidrift.net",
    "vidnest.fun",
    "devideosrc.co",
    "frembed.bar",
    "on.kinohub.vip",
    "graphql.anilist.co"
  ],
  "fetchHosts": "any",
  "streamHosts": "any",
  "screen": {
    "label": "StreamBert",
    "icon": "movie",
    "opensFrom": ["menu", "settings"],
    "settingsButton": {
      "label": "Abrir StreamBert"
    }
  },
  "recommends": ["xuper-plugin/kino-plugin-kino-resolver"],
  "consumes": {
    "resolver": {
      "repo": "xuper-plugin/kino-plugin-kino-resolver",
      "door": "resolver",
      "calls": ["resolve"]
    }
  },
  "settings": [
    {
      "key": "default_source",
      "type": "select",
      "label": "Fuente principal",
      "hint": "Servidor de extracción inicial para películas y series",
      "default": "vidfast",
      "options": [
        { "value": "vidfast", "label": "Vidfast (Recomendado)" },
        { "value": "vidsrc", "label": "VidSrc" },
        { "value": "vidlove", "label": "Vidlove" },
        { "value": "aether", "label": "Aether (Multi-idioma)" },
        { "value": "vidrift", "label": "Vidrift (Anime y películas)" }
      ]
    },
    {
      "key": "sub_lang",
      "type": "select",
      "label": "Idioma de subtítulos",
      "hint": "Preferencia de pista de subtítulos cuando estén disponibles",
      "default": "es",
      "options": [
        { "value": "es", "label": "Español (Castellano/Latino)" },
        { "value": "en", "label": "Inglés" }
      ]
    },
    {
      "key": "enable_resolver",
      "type": "toggle",
      "label": "Usar Kino Resolver",
      "hint": "Acelerar la resolución de hosters conocidos cuando estén presentes",
      "default": true
    }
  ]
}
